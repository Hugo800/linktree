{
  "name": "hugobarthelmess-de",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal link hub on https://hugobarthelmess.de",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "stats": "STATS_DATA=stats/.data GEO_DOWNLOAD=0 ALLOW_HEADLESS=1 ADMIN_PASSWORD=${ADMIN_PASSWORD:-dev} PORT=8787 node --disable-warning=ExperimentalWarning stats/server.mjs",
    "typecheck": "tsc",
    "test:stats": "node --test stats/test/*.test.mjs",
    "test": "tsc"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
